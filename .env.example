# 환경 변수 예시 파일. 이 파일은 Git에 올라가고, 실제 값은 들어 있지 않다.
# 사용법: 이 파일을 복사해서 .env.local을 만들고 실제 값을 채운다.
#         .env.local은 .gitignore의 *.local 규칙 때문에 Git에 올라가지 않는다.
#
# 값을 찾는 곳: Supabase 대시보드 → Project Settings → API Keys (주소는 Data API 또는 프로젝트 첫 화면)

# 프로젝트 주소. 예: https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# Publishable key (sb_publishable_로 시작). 브라우저에 공개돼도 되는 키다.
# ⚠️ Secret key(sb_secret_...)나 service_role 키는 절대 여기에 넣지 않는다.
#    VITE_ 변수는 빌드 결과물에 그대로 들어가서 누구나 볼 수 있기 때문이다.
VITE_SUPABASE_PUBLISHABLE_KEY=
